# Copy this file to `.env.local` (for your computer) and fill in the values.
# On Vercel, add the same two names under Project → Settings → Environment Variables.
#
# Find both in Supabase: Project Settings → API (or "Connect" → App frameworks).
# The "anon" / "publishable" key is designed to be public: it is safe in the
# browser because Row Level Security decides what each signed-in user can see.
# NEVER put the "service_role" / "secret" key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional — push notifications (Phase 5). The PUBLIC key from
# More → Notifications → "Set up push (admins)". Leave empty for in-app reminders only.
VITE_VAPID_PUBLIC_KEY=
